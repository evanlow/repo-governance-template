# Application
APP_ENV=development
SECRET_KEY=replace_with_local_dev_secret

# Database
DATABASE_URL=postgresql://replace_with_db_url

# Email / Notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_username
